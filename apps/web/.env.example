# Public — safe to expose to the browser
NEXT_PUBLIC_API_URL="http://localhost:3001"

# NextAuth / Besbpo ID (Keycloak) — this app is an OIDC client against the
# group's existing central Keycloak instance, same as apps/api.
AUTH_SECRET="" # generate with: npx auth secret
AUTH_KEYCLOAK_ID="bellwetherswe-web"
AUTH_KEYCLOAK_SECRET=""
AUTH_KEYCLOAK_ISSUER="https://id.besbpo.co.za/realms/besbpo"

# Error tracking — leave blank to disable (see instrumentation-client.ts,
# sentry.server.config.ts, sentry.edge.config.ts). NEXT_PUBLIC_ prefix on
# the client one is required — only prefixed vars reach the browser.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

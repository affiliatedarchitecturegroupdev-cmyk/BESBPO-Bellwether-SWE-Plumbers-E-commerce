# Environment for running `npm run test:e2e`.
#
# Unlike the unit tests (`npm test`), which mock PrismaService entirely and
# never touch a real database, this suite boots the ACTUAL AppModule via
# test/utils/create-test-app.ts — every real module, every real service.
# That means it needs a REAL Postgres database reachable at DATABASE_URL
# (ideally a disposable test database, e.g. a local Postgres container in
# CI — never point this at production or staging). Redis, PayFast,
# Keycloak, and AWS SES don't need to be reachable for the tests in
# test/app.e2e-spec.ts specifically (none of them exercise a real payment,
# a real login, or a real email) — they just need env.validation.ts's Joi
# schema to accept whatever value is set, so the app can boot at all.
#
# Copy this to .env.test and fill in DATABASE_URL with a real (test)
# database before running the suite.

DATABASE_URL="postgresql://user:password@localhost:5432/bellwetherswe_test"
REDIS_URL="redis://localhost:6379"
KEYCLOAK_ISSUER_URL="https://id.besbpo.co.za/realms/besbpo"
KEYCLOAK_JWKS_URI="https://id.besbpo.co.za/realms/besbpo/protocol/openid-connect/certs"
KEYCLOAK_AUDIENCE="bellwetherswe-api"
PAYFAST_MERCHANT_ID="10000100"
PAYFAST_MERCHANT_KEY="46f0cd694581a"
PAYFAST_MODE="sandbox"
PUBLIC_WEB_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:3001"
S3_BUCKET="test-bucket"
S3_REGION="af-south-1"

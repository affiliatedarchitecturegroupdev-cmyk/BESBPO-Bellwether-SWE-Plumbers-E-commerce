# Render provides DATABASE_URL and REDIS_URL automatically when the managed
# Postgres/Redis instances are linked to this service — these are placeholders
# for local development only.
DATABASE_URL="postgresql://user:password@localhost:5432/bellwether_ecommerce"
REDIS_URL="redis://localhost:6379"

PORT=3001
NODE_ENV=development

# Besbpo ID / Keycloak — this service is an OIDC client against the group's
# existing central Keycloak instance, not a new deployment.
KEYCLOAK_ISSUER_URL="https://id.besbpo.co.za/realms/besbpo"
KEYCLOAK_JWKS_URI="https://id.besbpo.co.za/realms/besbpo/protocol/openid-connect/certs"
KEYCLOAK_AUDIENCE="bellwetherswe-api"

# PayFast
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_MODE="sandbox"

# Used to build PayFast's return_url/cancel_url (web) and notify_url (api)
PUBLIC_WEB_URL="https://bellwetherswe.shop"
PUBLIC_API_URL="https://api.bellwetherswe.shop"

# AI service — internal Render network URL, not public
AI_SERVICE_URL="http://bellwetherswe-ai:8000"

# Error tracking — leave blank to disable (see src/instrument.ts)
SENTRY_DSN=""

# Real courier rate quotes via ShipLogic (the platform The Courier Guy's
# own official integrations run on) — leave SHIPLOGIC_API_KEY blank to
# disable; ShippingService falls back to a flat placeholder delivery fee
# automatically (see docs/AGENTS.md's logistics section). The warehouse
# address below is Bellwether's own collection/origin point for every
# quote — get this right, since a wrong "from" address makes every quoted
# rate meaningless even with a real API key configured.
SHIPLOGIC_API_KEY=""
WAREHOUSE_COMPANY="Bellwether SWE Plumbers"
WAREHOUSE_STREET_ADDRESS=""
WAREHOUSE_LOCAL_AREA=""
WAREHOUSE_CITY=""
WAREHOUSE_ZONE=""
WAREHOUSE_POSTAL_CODE=""

# Tax invoice generation — company name defaults to the real legal entity
# name. Address and VAT number are genuinely not configured here; without
# a real VAT number, generated documents are labeled "Invoice," not "Tax
# Invoice" (a legal term with real requirements under SA VAT law) — see
# docs/AGENTS.md.
INVOICE_COMPANY_ADDRESS=""
INVOICE_VAT_NUMBER=""

# SMS via BulkSMS.com — leave blank to disable; SMS is a best-effort
# addition alongside email (currently only for "your order has shipped"),
# not a replacement for it. See docs/AGENTS.md's SMS section.
BULKSMS_TOKEN_ID=""
BULKSMS_TOKEN_SECRET=""

# Notifications — 'log' (default) writes to stdout, no setup needed.
# 'ses' sends real email via AWS SES; only relevant to the worker process.
NOTIFICATION_CHANNEL="log"
AWS_SES_REGION="af-south-1"
NOTIFICATIONS_FROM_ADDRESS="orders@bellwetherswe.shop"

# Object storage (kept on S3 af-south-1 per the architecture plan)
S3_BUCKET="bellwether-swe-catalog"
S3_REGION="af-south-1"

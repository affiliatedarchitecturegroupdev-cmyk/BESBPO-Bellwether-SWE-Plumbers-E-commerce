# Read-only queries against the same Postgres instance apps/api writes to —
# this service should never write. Use a read-only DB role in production,
# not just application-level discipline.
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/bellwether_ecommerce"

# apps/api — for search-rank's delegated FTS lookup and estimate's pricing
# quote call. Reached over Render's private network in production, not the
# public internet.
API_BASE_URL="http://bellwetherswe-api:3001"

PORT=8000

# LLM-based classification for estimate_service — leave blank to disable;
# falls back to the rule-based classifier automatically (see
# app/services/llm_client.py and estimate_service.classify).
ANTHROPIC_API_KEY=""
